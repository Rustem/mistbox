# Dependencies & build output
node_modules/
.next/
.venv/
__pycache__/

# Secrets — real credentials live only in *.local / *.secret env files,
# never in git. Per-environment (qa/prod) secret files follow the same rule.
.env
.env.local
.env.*.local
*.env.local
*.secret.env
storefront/.env.local
# Resolved per-env files (e.g. from `op inject`). Templates (env/*.tpl) are safe.
env/*.env

# Noise
*.log
.DS_Store

# Claude Code local runtime state
.claude/
