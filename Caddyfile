# Shared across every environment on this box — one Caddy instance, TLS
# handled automatically (Let's Encrypt) per domain listed below. This is the
# ONLY service in the qa/prod overlays that publishes a port; every rule in
# this file is what the Hetzner Cloud Firewall's 80/443 rule actually protects.
#
# Service names (storefront/api/dashboard) resolve over the shared Docker
# network — see docker-compose.qa.yml.

qa.mist.box {
	reverse_proxy storefront:3000
}

api.qa.mist.box {
	# Saleor's own DEBUG=False build never serves /media/ itself — Django only
	# does that in DEBUG mode, on the assumption a CDN/S3 sits in front of it
	# in production. We have neither yet, so Caddy serves the shared
	# saleor-media volume directly, bypassing Django for this path only.
	# Without this, `Product.thumbnail`/`ProductMedia.url` 404 the instant a
	# Thumbnail DB row exists for that (media, size, format), even though the
	# file is sitting right there on disk — a real, launch-blocking gap found
	# while wiring up the QA fixture catalogue's photos.
	handle_path /media/* {
		root * /srv/media
		file_server
	}
	reverse_proxy api:8000
}

admin.qa.mist.box {
	reverse_proxy dashboard:80
}
