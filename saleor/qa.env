# qa overrides for saleor/common.env — loaded after it in docker-compose.qa.yml's
# env_file list, so only the keys listed here actually change; everything else
# (DEFAULT_CHANNEL_SLUG, DEFAULT_COUNTRY, DEFAULT_CURRENCY, EMAIL_URL) is
# inherited unchanged from common.env. No secrets here — SECRET_KEY comes from
# 1Password via env/saleor.env.tpl instead. See docs/… Runbook for the command.
ALLOWED_HOSTS=api.qa.mist.box,api,localhost
ALLOWED_CLIENT_HOSTS=https://qa.mist.box,https://admin.qa.mist.box
DASHBOARD_URL=https://admin.qa.mist.box/
DEBUG=False
PLAYGROUND_ENABLED=False
# Dev turns this off only so Saleor can fetch a manifest from
# host.docker.internal during local app install. qa has no such need — the
# storefront is a real internet host — so the SSRF guard stays on.
HTTP_IP_FILTER_ENABLED=True
