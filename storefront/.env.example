# ---- Saleor ----
# Public API used by the browser and by server components.
NEXT_PUBLIC_SALEOR_API_URL=http://localhost:8000/graphql/
# Same URL as seen from the Next.js server (identical for local dev).
SALEOR_API_URL=http://localhost:8000/graphql/
# App token with "Manage orders" + "Handle payments" permissions.
# Saleor 3.23 renamed Apps to Extensions: Configuration -> Extensions -> installed,
# or create one with the `appCreate` mutation. The token is shown once, at creation.
SALEOR_APP_TOKEN=
# The dashboard is a separate service on its own port — not a path under the
# API. docker-compose publishes it on 9000, which is the default.
NEXT_PUBLIC_SALEOR_DASHBOARD_URL=http://localhost:9000
NEXT_PUBLIC_SALEOR_CHANNEL=mistbox-us

# ---- Stripe ----
# Prefer a restricted key (rk_) over a secret key (sk_): this app only needs
# Checkout Sessions write and PaymentIntents read, so a leaked rk_ can do far
# less than a leaked sk_. Never commit a real key; never use an rk_live/sk_live
# outside production.
STRIPE_SECRET_KEY=rk_test_xxx
# Printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# for local testing; from the Dashboard endpoint for deployed environments.
# The two are different secrets — a local one will not verify production events.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Email (Resend) ----
# Send-only API key from resend.com. The Resend account is owned by
# billing@mist.box; the key cannot read logs or manage domains.
RESEND_API_KEY=re_xxx
# Must be an address on a domain verified in Resend.
RESEND_FROM="Mistbox <info@mist.box>"
# Where customer replies land. info@ is automated, so this points at a mailbox
# a person actually reads — the email footer promises one will answer.
RESEND_REPLY_TO=mrsdaniya@mist.box

# ---- Shipping (Shippo) ----
# Tracking, and buying a label from the admin in two taps. Test tokens start
# shippo_test_; in test mode Shippo accepts only the carrier "shippo" for
# tracking, so pair it with SHIPPO_TRANSIT / SHIPPO_DELIVERED and friends.
SHIPPO_API_TOKEN=shippo_test_xxx
# Carriers we can actually buy a label from, comma-separated. Shippo will
# quote a carrier that has never been registered on the account and only fail
# at purchase time, and every carrier account reports active=true either way —
# so this list is the only thing standing between "cheapest rate" and a label
# that cannot be bought. Add one only after a label has really been bought
# from it. Default: usps
SHIPPO_CARRIERS=usps
# Secret in the Shippo webhook URL. Stands in for HMAC signing, which Shippo
# must provision by request and takes up to 10 business days.
SHIPPO_WEBHOOK_TOKEN=

# ---- Webhooks and screens ----
# Shared secret Saleor sends as X-Mistbox-Webhook-Secret. Set by
# `node tools/register-webhooks.mjs`; Saleor only allows X-* header names.
SALEOR_WEBHOOK_SECRET=
# Signs the cookie that unlocks an order page's private half.
ORDER_REVEAL_SECRET=
# Signs the admin session cookie. /admin authenticates against Saleor's own
# staff accounts (see ADMIN_ALLOWED_DOMAIN in src/lib/adminAuth.ts) rather than
# a password of its own — this secret only protects the session that follows.
ADMIN_SESSION_SECRET=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
